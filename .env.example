# Copy to .env and adjust. Unset or empty = default.
LOG_LEVEL=info
# auto | direct | mp4 | adts | flac | mp3
OUTPUT_FORMAT=auto
CACHE_MB=512
#MP3_BITRATE=192k
#FLAC_BITS=16
#PREFETCH=true
#GAPLESS=true
#ADVERTISE_IP=192.168.1.10
#RENDERER_INCLUDE=
#RENDERER_EXCLUDE=Samsung|LG
#STATUS_PORT=8080
#UPNPTUBE_IMAGE=ghcr.io/<you>/upnptube:latest
