# Copy to .env and adjust. Unset or empty = default.
LOG_LEVEL=info
# auto | direct | mp4 | adts | flac | mp3
OUTPUT_FORMAT=auto
CACHE_MB=512
#MP3_BITRATE=192k
#FLAC_BITS=16
#PREFETCH=true
#GAPLESS=true
#SPONSORBLOCK=false
#SPONSORBLOCK_CATEGORIES=music_offtopic,sponsor,selfpromo,interaction
#ADVERTISE_IP=192.168.1.10
#RENDERER_INCLUDE=
#RENDERER_EXCLUDE=Samsung|LG
#STATUS_PORT=8080
#STATUS_TOKEN=
#TUBE2UPNP_IMAGE=ghcr.io/deaksa/tube2upnp:latest
