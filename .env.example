# Copy to .env and adjust. Unset or empty = default.
LOG_LEVEL=info
# auto | direct | mp4 | adts | flac | mp3
OUTPUT_FORMAT=auto
CACHE_MB=512
#MP3_BITRATE=192k
#FLAC_BITS=16
#PREFETCH=true
#GAPLESS=true
#SPONSORBLOCK=false
#SPONSORBLOCK_CATEGORIES=music_offtopic,sponsor,selfpromo,interaction
#HISTORY=true
#HISTORY_MAX=5000
#HISTORY_MIN_PLAY_S=30
#ADVERTISE_IP=192.168.1.10
#RENDERER_INCLUDE=
#RENDERER_EXCLUDE=Samsung|LG
#STATUS_PORT=8080
#STATUS_TOKEN=
#STATUS_BIND=
#NAME_TEMPLATE=🔊 {name}
#AUTOPLAY=true
#START_TIMEOUT_MS=12000
#POLL_INTERVAL_MS=2000
#DISCOVERY_INTERVAL=300
#SPONSORBLOCK_API=https://sponsor.ajay.app
#YTDLP_FORMAT=bestaudio[ext=m4a]/bestaudio[acodec^=mp4a]/bestaudio/best
# Put cookies.txt in the data volume, e.g. for "Sign in to confirm you're not a bot":
#YTDLP_EXTRA_ARGS=--cookies /data/cookies.txt
#YTDLP_UPDATE_HOURS=24
#YTDLP_UPDATE_ON_START=true
#TUBE2UPNP_IMAGE=ghcr.io/deaksa/tube2upnp:latest
