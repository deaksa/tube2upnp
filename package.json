{
  "name": "tube2upnp",
  "version": "0.4.0",
  "description": "Tube2U[PnP]: cast from the YouTube / YouTube Music apps to DLNA/UPnP renderers (a fork of upnpTube)",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "tube2upnp": "src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test 'test/**/*.test.js'",
    "lint": "eslint src test"
  },
  "keywords": [
    "audio",
    "cast",
    "dlna",
    "music",
    "sponsorblock",
    "upnp",
    "upnptube",
    "youtube",
    "youtube-music"
  ],
  "author": "Mark Smith (original upnpTube), Tube2U[PnP] contributors",
  "license": "GPL-3.0-only",
  "dependencies": {
    "elementtree": "^0.1.7",
    "node-persist": "^3.1.3",
    "yt-cast-receiver": "^2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
